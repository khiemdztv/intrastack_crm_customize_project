<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Role groups are intentionally hidden from the generic user form.
             HR managers assign roles from the Employee record so onboarding
             stays auditable and does not create portal-only users. -->
        <record id="group_intrastack_sales_manager" model="res.groups">
            <field name="name">IntraStack Role: Sales Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_manager')),
                (4, ref('sale_management.group_sale_order_template')),
                (4, ref('project.group_project_user')),
                (4, ref('hr_timesheet.group_hr_timesheet_approver'))
            ]"/>
        </record>

        <record id="group_intrastack_sales_executive" model="res.groups">
            <field name="name">IntraStack Role: Sales Executive</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_salesman')),
                (4, ref('sale_management.group_sale_order_template')),
                (4, ref('project.group_project_user')),
                (4, ref('hr_timesheet.group_hr_timesheet_user'))
            ]"/>
        </record>

        <record id="group_intrastack_recruiter" model="res.groups">
            <field name="name">IntraStack Role: Recruiter</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_salesman_all_leads')),
                (4, ref('project.group_project_user'))
            ]"/>
        </record>

        <record id="group_intrastack_project_manager" model="res.groups">
            <field name="name">IntraStack Role: Project Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('sales_team.group_sale_salesman_all_leads')),
                (4, ref('project.group_project_manager')),
                (4, ref('hr_timesheet.group_hr_timesheet_approver'))
            ]"/>
        </record>

        <record id="group_intrastack_consultant" model="res.groups">
            <field name="name">IntraStack Role: Consultant</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('project.group_project_user')),
                (4, ref('hr_timesheet.group_hr_timesheet_user'))
            ]"/>
        </record>
    </data>
</odoo>
