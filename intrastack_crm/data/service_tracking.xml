<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Keep exactly one project-generating line in each commercial
            template. This preserves one CRM contract -> one delivery project
            while the other lines remain billable service lines.
        -->
        <record id="product_staffing_resource" model="product.product">
            <field name="service_tracking">project_only</field>
            <field name="project_template_id" ref="project_template_staffing"/>
            <field name="invoice_policy">delivery</field>
            <field name="service_type">timesheet</field>
        </record>

        <record id="product_consulting_discovery" model="product.product">
            <field name="service_tracking">project_only</field>
            <field name="project_template_id" ref="project_template_consulting"/>
            <field name="invoice_policy">order</field>
            <field name="service_type">manual</field>
        </record>

        <record id="product_managed_monthly" model="product.product">
            <field name="service_tracking">project_only</field>
            <field name="project_template_id" ref="project_template_managed_service"/>
            <field name="invoice_policy">order</field>
            <field name="service_type">manual</field>
        </record>
    </data>
</odoo>
